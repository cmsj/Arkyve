    "Create a new compressed archive and optionally add some files to it. Supports creating archives in these formats: .zip, .7z, .iso, .cpio, .tar, .tar.gz, .tar.bz, .tar.xz, .xar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erstellen Sie ein neues komprimiertes Archiv und fügen Sie optional einige Dateien hinzu. Unterstützt das Erstellen von Archiven in diesen Formaten: .zip, .7z, .iso, .cpio, .tar, .tar.gz, .tar.bz, .tar.xz, .xar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Create a new compressed archive and optionally add some files to it. Supports creating archives in these formats: .zip, .7z, .iso, .cpio, .tar, .tar.gz, .tar.bz, .tar.xz, .xar"
          }
        }
      }
    },
    "Create a new compressed archive with the contents of an existing archive. Supports creating archives in these formats: .zip, .7z, .iso, .cpio, .tar, .tar.gz, .tar.bz, .tar.xz, .xar. Supports existing archives in these formats: .zip, .7z, .rar, .iso, .cpio, .tar.gz, .tar.bz, .tar.xz, .lha, .lzh, .cab, .a, .xip, .xar, .pkg" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erstellen Sie ein neues komprimiertes Archiv mit dem Inhalt eines vorhandenen Archivs. Unterstützt das Erstellen von Archiven in diesen Formaten: .zip, .7z, .iso, .cpio, .tar, .tar.gz, .tar.bz, .tar.xz, .xar. Unterstützt vorhandene Archive in diesen Formaten: .zip, .7z, .rar, .iso, .cpio, .tar.gz, .tar.bz, .tar.xz, .lha, .lzh, .cab, .a, .xip, .xar, .pkg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Create a new compressed archive with the contents of an existing archive. Supports creating archives in these formats: .zip, .7z, .iso, .cpio, .tar, .tar.gz, .tar.bz, .tar.xz, .xar. Supports existing archives in these formats: .zip, .7z, .rar, .iso, .cpio, .tar.gz, .tar.bz, .tar.xz, .lha, .lzh, .cab, .a, .xip, .xar, .pkg"
          }
        }
      }
    },
