    "This archive has unsaved changes, do you want to close it without saving?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذا الأرشيف يحتوي على تغييرات غير محفوظة، هل تريد إغلاقه دون حفظ؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Archiv enthält ungespeicherte Änderungen. Möchten Sie es schließen, ohne zu speichern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This archive has unsaved changes, do you want to close it without saving?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este archivo tiene cambios no guardados, ¿desea cerrarlo sin guardar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cet archive contient des modifications non enregistrées, voulez-vous la fermer sans enregistrer ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לארכיון זה יש שינויים שלא נשמרו, האם ברצונך לסגור אותו ללא שמירה?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questo archivio ha modifiche non salvate, vuoi chiuderlo senza salvare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このアーカイブには保存されていない変更があります。保存せずに閉じてもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 아카이브에는 저장되지 않은 변경 사항이 있습니다. 저장하지 않고 닫으시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit archief heeft niet-opgeslagen wijzigingen, wil je het sluiten zonder op te slaan?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В этом архиве есть несохранённые изменения. Вы хотите закрыть его без сохранения?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu arşivde kaydedilmemiş değişiklikler var, kaydetmeden kapatmak istiyor musunuz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此档案有未保存的更改，您确定要不保存就关闭吗？"
          }
        }
      }
    },
    "This archive's format is read-only. Use Save As to select a writable format if you need to make changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنسيق هذا الأرشيف للقراءة فقط. استخدم \"حفظ باسم\" لاختيار تنسيق قابل للكتابة إذا كنت بحاجة إلى إجراء تغييرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Format dieses Archivs ist schreibgeschützt. Verwenden Sie \"Speichern unter\", um ein beschreibbares Format auszuwählen, wenn Sie Änderungen vornehmen müssen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This archive's format is read-only. Use Save As to select a writable format if you need to make changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El formato de este archivo es de solo lectura. Use Guardar como para seleccionar un formato escribible si necesita hacer cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le format de cette archive est en lecture seule. Utilisez Enregistrer sous pour sélectionner un format modifiable si vous devez apporter des modifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הפורמט של הארכיון הזה הוא לקריאה בלבד. השתמש ב\"שמור בשם\" כדי לבחור פורמט שניתן לכתיבה אם אתה צריך לבצע שינויים."
          }
        },
